# --- Cloudflare R2 (private gallery media) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=alejoframes

# --- Resend (magic-link + notifications) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@alejoframes.com

# --- Auth (NextAuth v5) ---
# Generate AUTH_SECRET with: openssl rand -base64 32
# The comment stays on its own line, never trailing a value: Bun strips a
# trailing `# ...` from a value and systemd does not, so the same line yields
# a different secret depending on which one reads it.
AUTH_SECRET=
AUTH_URL=http://localhost:3300

# --- Environment ---
# Namespaces R2 object keys. src/lib/r2.ts prefixes every key with `dev/`
# unless this is exactly "production", so an environment that forgets to set
# it writes into the dev namespace rather than over a real client's photos.
# Fail-closed by design — leave it as `development` locally.
APP_ENV=development

# --- Operator tokens (nothing in this repo reads these) ---
# Used by hand, outside the application: neither appears anywhere in src/,
# scripts/, infra/ or .github/. Listed so the values have a documented home,
# NOT because the app needs them to boot — do not go looking for the code
# that consumes them.
CLOUDFLARE_API_TOKEN=
RESEND_ADMIN_API_KEY=
