#!/usr/bin/env sh
# TRACKED fallback for git's pre-commit hook.
#
# core.hooksPath is `.husky/_`, and `.husky/_` is normally entirely
# generated by husky's `prepare` script on `bun install` -- ignored via its
# own generated `.husky/_/.gitignore` (content `*`). That is exactly the
# bug: a worktree that has never run `bun install` has no `.husky/_` at
# all, so git resolves a hooksPath pointing at nothing and silently runs no
# hook whatsoever. No error, no warning, the commit just succeeds.
#
# This one file is tracked in git despite living under `.husky/_`, the
# same way `.claude/agents/` is re-included from an otherwise-ignored
# `.claude/*`. Being tracked, it is present in a worktree's working tree
# from the moment `git worktree add` populates it -- before any install.
#
# `bun install` overwrites this exact path unconditionally every time (see
# node_modules/husky/index.js: `l.forEach(h => w(_(h), ...))`), replacing
# it with husky's own generated shim that delegates to `.husky/pre-commit`.
# So this fallback only ever governs the window before the first install
# in a given worktree -- which is exactly and only the window where the
# bug exists. Once installed, this file's content stops mattering; the
# real generated shim takes over, unchanged from before this fix.
#
# See #123.

if [ ! -d "node_modules" ]; then
	echo "husky - pre-commit BLOCKED: node_modules is missing." >&2
	echo "  This worktree has not run 'bun install' yet, so lint-staged" >&2
	echo "  (eslint --fix, prettier --write) cannot run on this commit." >&2
	echo "  Run 'bun install' now, then retry the commit." >&2
	exit 1
fi

# node_modules exists but husky has not (yet) regenerated this file --
# e.g. an install ran with --ignore-scripts. Run the same check directly
# rather than silently letting the commit through.
exec bunx lint-staged
